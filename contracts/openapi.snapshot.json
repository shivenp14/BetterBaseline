      "ScenarioGridRequest": {
        "additionalProperties": false,
        "description": "Request for generating the 2D power grid surface and 1D power curve.\n\nThe power curve slices analytic power across x_baseline holding dropout fixed\nat selected_scenario.dropout (or 0.0 if omitted). Each curve point uses floored\nexpected retention floor(enrolled_n * (1 - dropout)) and the effective effect.",
        "properties": {
          "effect_override": {
            "anyOf": [
              {
                "discriminator": {
                  "mapping": {
                    "absolute_risk_reduction": "#/components/schemas/AbsoluteRiskReductionEffect",
                    "relative_risk": "#/components/schemas/RelativeRiskEffect"
                  },
                  "propertyName": "kind"
                },
                "oneOf": [
                  {
                    "$ref": "#/components/schemas/RelativeRiskEffect"
                  },
                  {
                    "$ref": "#/components/schemas/AbsoluteRiskReductionEffect"
                  }
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Effect Override"
          },
          "fixed_enrollment": {
            "$ref": "#/components/schemas/ArmCounts"
          },
          "planned_design": {
            "$ref": "#/components/schemas/TrialAssumptions"
          },
          "provenance": {
            "additionalProperties": {
              "$ref": "#/components/schemas/FieldProvenance"
            },
            "title": "Provenance",
            "type": "object"
          },
          "selected_scenario": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/StressScenario"
              },
              {
                "type": "null"
              }
            ],
            "description": "Selected stress scenario providing the selected baseline risk and dropout level for selected_point and power_curve"
          },
          "x_baseline": {
            "$ref": "#/components/schemas/GridAxisSpec"
          },
          "y_dropout": {
            "$ref": "#/components/schemas/GridDropoutAxisSpec"
          }
        },
        "required": [
          "planned_design",
          "fixed_enrollment"
        ],
        "title": "ScenarioGridRequest",
        "type": "object"
      },
      "ScenarioGridResponse": {
        "properties": {
          "analytic_delta": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Selected minus original planned power in fraction units, independent of grid-domain validity; null when either comparison point is unavailable.",
            "title": "Analytic Delta"
          },
          "below_target": {
            "items": {
              "items": {
                "anyOf": [
                  {
