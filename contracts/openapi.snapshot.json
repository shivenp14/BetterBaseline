            "exclusiveMinimum": 0.0,
            "title": "Control Event Rate",
            "type": "number"
          },
          "dropout": {
            "$ref": "#/components/schemas/ArmProportions"
          },
          "effect": {
            "discriminator": {
              "mapping": {
                "absolute_risk_reduction": "#/components/schemas/AbsoluteRiskReductionEffect",
                "relative_risk": "#/components/schemas/RelativeRiskEffect"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/components/schemas/RelativeRiskEffect"
              },
              {
                "$ref": "#/components/schemas/AbsoluteRiskReductionEffect"
              }
            ],
            "title": "Effect"
          },
          "model_version": {
            "const": "binary-v1",
            "default": "binary-v1",
            "title": "Model Version",
            "type": "string"
          },
          "target_power": {
            "default": 0.8,
            "description": "Target statistical power",
            "exclusiveMaximum": 1.0,
            "exclusiveMinimum": 0.0,
            "title": "Target Power",
            "type": "number"
          }
        },
        "required": [
          "control_event_rate",
          "effect"
        ],
        "title": "TrialAssumptions",
        "type": "object"
      }
    }
