# Optional backend-only PostgreSQL DSN. Leave empty to use in-memory fixtures.
# Supabase: use the Connect dialog's direct or session pooler connection string.
# Keep credentials out of browser configuration. Use verified TLS for hosted DBs.
DATABASE_URL=
# Local storage defaults to backend/.private-uploads (excluded from Git).
LOCAL_STORAGE_ROOT=
# Set all three to use an existing PRIVATE Supabase bucket instead of local disk.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=
