# Optional backend-only PostgreSQL DSN. Leave empty to use in-memory fixtures.
# Supabase: use the Connect dialog's direct or session pooler connection string.
# Keep credentials out of browser configuration. Use verified TLS for hosted DBs.
DATABASE_URL=
# Defaults to required. Set demo only for the localhost synthetic rehearsal.
TRIALSYNC_AUTH_MODE=required
# Exact comma-separated browser origins; never use a wildcard.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Supabase project publishable key, used only to verify USER bearer access tokens.
# Never put a service-role/secret key here or in frontend environment variables.
SUPABASE_PUBLISHABLE_KEY=
# Local storage defaults to backend/.private-uploads (excluded from Git).
LOCAL_STORAGE_ROOT=
# Set all three to use an existing PRIVATE Supabase bucket instead of local disk.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=
